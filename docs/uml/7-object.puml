@startuml Amdox-ERP-Object
title Amdox ERP — Object Diagram (Runtime Snapshot)

' What this shows: a single concrete example of the data at runtime — the
' seeded demo tenant, its super-admin user, that user's role, one permission
' the role grants, and one invoice the tenant owns. It's the Class Diagram
' made real with actual seeded values.

object "amdox : Tenant" as t {
  name = "Amdox Technologies"
  slug = "amdox-demo"
  plan = "ENTERPRISE"
  isActive = true
}

object "superAdmin : User" as u1 {
  email = "admin@amdox.com"
  isActive = true
  mfaEnabled = false
}

object "role : Role" as r {
  name = "super_admin"
  isSystem = true
}

object "perm : Permission" as p {
  resource = "user"
  action = "create"
}

object "invAR : Invoice" as inv {
  invoiceNumber = "INV-AR-2026-001"
  type = "AR"
  totalAmount = 1003000
  status = "PAID"
}

object "payment : Payment" as pay {
  amount = 1003000
  method = "CHEQUE"
  status = "COMPLETED"
}

t --> u1 : has
u1 --> r : assigned (UserRole)
r --> p : grants (RolePermission)
t --> inv : owns
inv --> pay : settled by

note bottom of t
  This is the tenant you log into as
  admin@amdox.com / Admin@1234.
end note
@enduml
